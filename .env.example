# Copy to .env and fill in. Never commit .env. Every value is optional for a local run.
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=./data/proxyproof.db

# PayPal developer sandbox app. Sandbox only: the client refuses any other PayPal host.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal account that plays the buyer and approves checkouts on PayPal.
PAYPAL_SANDBOX_RECEIVER_EMAIL=
# Sandbox business account email behind PAYPAL_CLIENT_ID. Shown as the seller's verified PayPal account.
PAYPAL_SANDBOX_MERCHANT_EMAIL=
# Webhook ID from the PayPal developer dashboard. Without it every webhook is rejected (fail closed);
# payment status is still read through the authenticated PayPal API.
PAYPAL_WEBHOOK_ID=
