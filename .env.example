# Copy to .env and fill in. Never commit .env. Every value is optional for a local run.
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=./data/payeeproof.db
# Long random string. Signs decisions. Generated into the database when unset (fine locally, set it in production).
SERVER_SECRET=

# PayPal developer sandbox app (Merchant). Sandbox only: the executor refuses live URLs.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal account email that the demo vendor is paid at.
PAYPAL_SANDBOX_RECEIVER_EMAIL=
# Webhook ID from the PayPal developer dashboard. Without it every webhook is rejected (fail closed).
PAYPAL_WEBHOOK_ID=

# Optional. Enables Claude extraction and investigator notes. Deterministic extraction works without it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_DAILY_CALL_LIMIT=300

# DNS, RDAP and homepage lookups for sender domains (corroboration only): on or off.
PUBLIC_EVIDENCE=on
